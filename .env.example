# FarmDB configuration.
# Copy this file to .env and adjust. Every value has a working default, so .env
# is optional for local development. Never commit your real .env.

# Which environment this instance runs as: dev or prod
ENVIRONMENT=dev

# Path to the DuckDB database file. Under docker compose this is overridden to
# a path inside the container's own volume, so the containerised API and a host
# one never write the same file — DuckDB allows a single writer.
DATABASE_PATH=farm.db

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty in dev, a random secret is used per start (logins reset on restart).
# Set a strong, stable value in production.
JWT_SECRET_KEY=

# Login token settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Passkey (WebAuthn) settings. Set these to your own domain in production.
# WEBAUTHN_ORIGIN is the origin the browser reports during a passkey ceremony:
# the API's own, since it serves the app. Working on passkeys from the Next dev
# server instead? Point it at that origin (http://localhost:3000).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=FarmDB
WEBAUTHN_ORIGIN=http://localhost:5700

# Browser origins allowed to call the API cross-origin, as a JSON list. Empty
# by default, and nothing needs it while the API serves the web app: the Next
# dev server proxies /v1 to the API, so those calls are same-origin too. Set it
# only to reach this API from a web app served somewhere else, e.g.
#   CORS_ORIGINS=["http://localhost:3000"]
CORS_ORIGINS=[]
