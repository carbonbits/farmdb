# FarmDB configuration.
# Copy this file to .env and adjust. Every value has a working default, so .env
# is optional for local development. Never commit your real .env.

# Which environment this instance runs as: dev or prod
ENVIRONMENT=dev

# Path to the DuckDB database file
DATABASE_PATH=farm.db

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Left empty in dev, a random secret is used per start (logins reset on restart).
# Set a strong, stable value in production.
JWT_SECRET_KEY=

# Login token settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Passkey (WebAuthn) settings. Set these to your own domain in production.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=FarmDB
WEBAUTHN_ORIGIN=http://localhost:5700
